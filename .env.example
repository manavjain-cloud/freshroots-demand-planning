# ---------------------------------------------------------------------------
# Freshroots Demand Planning — environment variables (placeholders only).
# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these in Project Settings → Environment Variables.
# ---------------------------------------------------------------------------

# Neon PostgreSQL connection string (use the pooled host, *-pooler.*).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require

# Gemini key. Either a Google AI Studio key (calls the Gemini API directly)
# or an OpenRouter key starting with sk-or- (calls Gemini models via OpenRouter).
GEMINI_API_KEY=your-gemini-or-openrouter-key
# Optional alternative for an OpenRouter key; GEMINI_API_KEY takes priority if it is a Google key.
# OPENROUTER_API_KEY=

# Optional AI tuning
# AI_MODEL=gemini-3.8-flash            # with OpenRouter: google/gemini-3.8-flash
# AI_MODEL_FALLBACKS=gemini-3.6-flash,gemini-flash-latest
# AI_TIMEOUT_MS=30000
# AI_RATE_LIMIT_PER_HOUR=30            # per client IP (hashed)
# AI_RATE_LIMIT_GLOBAL_PER_DAY=300

# Optional shared access password (HTTP Basic). Restricts the site; does NOT identify reviewers.
# BASIC_AUTH_USER=
# BASIC_AUTH_PASSWORD=

# Zoho Inventory — NEXT PHASE. Not used by this version; listed so the future
# integration has a home. Do not set until API access and scopes are confirmed.
# ZOHO_API_DOMAIN=https://www.zohoapis.in
# ZOHO_ORGANIZATION_ID=
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REFRESH_TOKEN=
